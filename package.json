{
  "name": "velocitybook",
  "version": "1.0.0",
  "private": true,
  "description": "Real-Time In-Memory Order Book & Matching Engine with ACID Double-Entry Ledger",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "cd packages/backend && npm run dev",
    "dev:frontend": "cd packages/frontend && npm run dev",
    "build": "npm run build --workspaces",
    "test": "cd packages/engine && npx vitest run",
    "stress-test": "npx ts-node scripts/stress-test.ts",
    "scale-test": "npx ts-node scripts/scale-test.ts",
    "benchmark:serialization": "npx ts-node scripts/benchmark-serialization.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
