{
  "name": "@velocitybook/backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "worker": "ts-node src/workers/EngineWorker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/EngineWorker.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@velocitybook/engine": "1.0.0",
    "express": "^4.19.0",
    "cors": "^2.8.5",
    "ws": "^8.17.0",
    "pg": "^8.12.0",
    "ioredis": "^5.4.0",
    "decimal.js": "^10.4.3",
    "uuid": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "ts-node-dev": "^2.0.0",
    "ts-node": "^10.9.0",
    "@types/node": "^20.14.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/ws": "^8.5.10",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "vitest": "^2.0.0"
  }
}
